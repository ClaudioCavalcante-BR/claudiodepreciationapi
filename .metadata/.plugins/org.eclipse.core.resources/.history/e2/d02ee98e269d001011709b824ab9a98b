package br.edu.infnet.claudioapi.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import br.edu.infnet.claudioapi.model.dto.TruckQueryResult;
import br.edu.infnet.claudioapi.model.service.TruckGatewayService;

@RestController
@RequestMapping("/api/trucks")
public class TruckGatewayController {
	
	 private final TruckGatewayService service;

	    public TruckGatewayController(TruckGatewayService service) {
	        this.service = service;
	    }

	    // Proxy de consulta consolidada via claudiodepreciationapi
	    // GET http://localhost:8081/api/trucks/116/10602/2025-3
	    @GetMapping("/{marcaId}/{modeloId}/{anoCodigo}")
	    public TruckQueryResult consultar(
	            @PathVariable Integer marcaId,
	            @PathVariable Integer modeloId,
	            @PathVariable String anoCodigo) {
	        return service.consultar(marcaId, modeloId, anoCodigo);
	    }
	

}
